# Questo repository è PUBBLICO: qui dentro non deve finire nulla di privato.

# dati/Gestione.xlsx È VERSIONATO di proposito: è la fonte di verità del sito,
# e tenerlo sotto Git significa averne uno storico e poter tornare indietro.
# Restano esclusi i file temporanei che Excel crea mentre lo tieni aperto.
~$*.xlsx
*.xlsx#

# Gli screenshot delle rose pesano decine di MB e questo repository è pubblico:
# una volta in cronologia se li porterebbe dietro ogni clone, per sempre.
# I CSV della stessa cartella restano versionati: sono pochi KB e servono come
# traccia dell'asta.
dati/**/*.PNG
dati/**/*.png

# Database e altri formati che qui non servono
*.db
*.sqlite
*.sqlite3

# Ambiente Python locale
.venv/
__pycache__/
*.py[cod]

# Segreti
.env
.env.*

# Sistema ed editor
Thumbs.db
.DS_Store
.vscode/
.idea/
